BEGIN TRANSACTION;
CREATE TABLE IF NOT EXISTS "Frota_ERRADA" (
	"id_registro"	INTEGER,
	"placa"	TEXT,
	"marca"	TEXT,
	"modelo"	TEXT,
	"nome_cliente"	TEXT,
	"cpf_cliente"	TEXT,
	"data_locacao"	TEXT,
	"data_devolucao"	TEXT,
	"descricao_manutencao"	TEXT,
	"data_manutencao"	TEXT,
	"descricao_multa"	TEXT,
	"valor_multa"	REAL,
	PRIMARY KEY("id_registro")
);
CREATE TABLE IF NOT EXISTS "clientes" (
	"id_cliente"	INTEGER,
	"nome"	TEXT NOT NULL,
	"cpf"	TEXT NOT NULL UNIQUE,
	"telefone"	TEXT,
	PRIMARY KEY("id_cliente" AUTOINCREMENT)
);
CREATE TABLE IF NOT EXISTS "locacoes" (
	"id_locacao"	INTEGER,
	"id_veiculo"	INTEGER NOT NULL,
	"id_cliente"	INTEGER NOT NULL,
	"data_retirada"	TEXT NOT NULL,
	"data_prevista_devolucao"	TEXT NOT NULL,
	"data_devolucao"	TEXT,
	"status"	TEXT NOT NULL DEFAULT 'ATIVA' CHECK("status" IN ('ATIVA', 'ENCERRADA', 'CANCELADA')),
	"valor_total"	REAL CHECK("valor_total" IS NULL OR "valor_total" >= 0),
	PRIMARY KEY("id_locacao" AUTOINCREMENT),
	FOREIGN KEY("id_cliente") REFERENCES "clientes"("id_cliente"),
	FOREIGN KEY("id_veiculo") REFERENCES "veiculos"("id_veiculo"),
	CHECK("data_prevista_devolucao" >= "data_retirada"),
	CHECK("data_devolucao" IS NULL OR "data_devolucao" >= "data_retirada")
);
CREATE TABLE IF NOT EXISTS "manutencoes" (
	"id_manutencao"	INTEGER,
	"id_veiculo"	INTEGER NOT NULL,
	"descricao"	TEXT NOT NULL,
	"data_inicio"	TEXT NOT NULL,
	"data_fim"	TEXT,
	"status"	TEXT NOT NULL DEFAULT 'ABERTA' CHECK("status" IN ('ABERTA', 'EM_ANDAMENTO', 'CONCLUIDA')),
	"custo"	REAL CHECK("custo" IS NULL OR "custo" >= 0),
	PRIMARY KEY("id_manutencao" AUTOINCREMENT),
	FOREIGN KEY("id_veiculo") REFERENCES "veiculos"("id_veiculo"),
	CHECK("data_fim" IS NULL OR "data_fim" >= "data_inicio")
);
CREATE TABLE IF NOT EXISTS "multas" (
	"id_multa"	INTEGER,
	"id_veiculo"	INTEGER NOT NULL,
	"descricao"	TEXT NOT NULL,
	"data_infracao"	TEXT NOT NULL,
	"valor"	REAL NOT NULL CHECK("valor" >= 0),
	"status_pagamento"	TEXT NOT NULL DEFAULT 'PENDENTE' CHECK("status_pagamento" IN ('PENDENTE', 'PAGA', 'EM_RECURSO')),
	PRIMARY KEY("id_multa" AUTOINCREMENT),
	FOREIGN KEY("id_veiculo") REFERENCES "veiculos"("id_veiculo")
);
CREATE TABLE IF NOT EXISTS "veiculos" (
	"id_veiculo"	INTEGER,
	"placa"	TEXT NOT NULL UNIQUE,
	"marca"	TEXT NOT NULL,
	"modelo"	TEXT NOT NULL,
	"ano"	INTEGER NOT NULL CHECK("ano" >= 1900),
	"status"	TEXT NOT NULL DEFAULT 'DISPONIVEL' CHECK("status" IN ('DISPONIVEL', 'ALUGADO', 'MANUTENCAO', 'INATIVO')),
	PRIMARY KEY("id_veiculo" AUTOINCREMENT)
);
