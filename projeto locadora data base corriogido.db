CREATE VIEW vw_veiculos_disponiveis AS
SELECT
    v.id_veiculo,
    v.placa,
    v.marca,
    v.modelo,
    v.ano
FROM veiculos AS v
WHERE v.status = 'DISPONIVEL'
  AND NOT EXISTS (
      SELECT 1
      FROM locacoes AS l
      WHERE l.id_veiculo = v.id_veiculo
        AND l.status = 'ATIVA'
  )
  AND NOT EXISTS (
      SELECT 1
      FROM manutencoes AS m
      WHERE m.id_veiculo = v.id_veiculo
        AND m.status IN ('ABERTA', 'EM_ANDAMENTO')
  );
CREATE INDEX IF NOT EXISTS "idx_locacoes_cliente" ON "locacoes" (
	"id_cliente"
);
CREATE INDEX IF NOT EXISTS "idx_locacoes_veiculo_status" ON "locacoes" (
	"id_veiculo",
	"status"
);
CREATE INDEX IF NOT EXISTS "idx_manutencoes_veiculo_status" ON "manutencoes" (
	"id_veiculo",
	"status"
);
CREATE INDEX IF NOT EXISTS "idx_multas_data" ON "multas" (
	"data_infracao"
);
CREATE INDEX IF NOT EXISTS "idx_multas_veiculo" ON "multas" (
	"id_veiculo"
);
CREATE INDEX IF NOT EXISTS "idx_veiculos_status" ON "veiculos" (
	"status"
);
COMMIT;
